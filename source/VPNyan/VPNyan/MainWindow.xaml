<Window x:Class="VPNyan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VPNyan"
        Title="VPN4ik" Icon="/VPNyan;component/Assets/VPN4ik.ico" Height="740" Width="1040" MinWidth="760" MinHeight="540"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#110911" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavigationLabel" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="FontSize" Value="13"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggleButton}" Value="True">
                <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9A15C"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="NavItemBorder" Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2,0,0,0"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItemBorder" Property="Background" Value="#281622"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavItemBorder" Property="BorderBrush" Value="#FFD27A"/><Setter Property="Foreground" Value="#FFD27A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C9A15C"/><Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleBorder" Background="Transparent" CornerRadius="8"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#281622"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" Background="#1A0F1A" MouseDown="TopBar_MouseDown" Panel.ZIndex="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="VPN4ik" Foreground="#A78762" VerticalAlignment="Center" FontSize="12" Margin="8,0" IsHitTestVisible="False"/>
            <Button x:Name="MinimizeButton" Grid.Column="2" Click="Minimize_Click" Style="{StaticResource WindowButton}" ToolTip="{Binding [L000], Source={x:Static local:Localization.Current}}" AutomationProperties.Name="{Binding [L001], Source={x:Static local:Localization.Current}}">
                <Grid Width="20" Height="20" IsHitTestVisible="False"><Path Data="M 2,10 L 18,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
            </Button>
            <Button x:Name="MaximizeButton" Grid.Column="3" Click="Maximize_Click">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource WindowButton}"><Setter Property="ToolTip" Value="{Binding [L002], Source={x:Static local:Localization.Current}}"/><Setter Property="AutomationProperties.Name" Value="{Binding [L003], Source={x:Static local:Localization.Current}}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="{Binding [L004], Source={x:Static local:Localization.Current}}"/><Setter Property="AutomationProperties.Name" Value="{Binding [L005], Source={x:Static local:Localization.Current}}"/></DataTrigger></Style.Triggers>
                </Style></Button.Style>
                <Grid Width="20" Height="20" IsHitTestVisible="False"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round">
                    <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 3,3 H 17 V 17 H 3 Z"/>
                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 6,3 H 17 V 14 H 14 M 3,6 H 14 V 17 H 3 Z"/></DataTrigger></Style.Triggers>
                    </Style></Path.Style>
                </Path></Grid>
            </Button>
            <Button x:Name="CloseWindowButton" Tag="Close" Grid.Column="4" Click="Close_Click" Style="{StaticResource WindowButton}" ToolTip="{Binding [L006], Source={x:Static local:Localization.Current}}" AutomationProperties.Name="{Binding [L007], Source={x:Static local:Localization.Current}}">
                <Grid Width="20" Height="20" IsHitTestVisible="False"><Path Data="M 3,3 L 17,17 M 17,3 L 3,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
            </Button>
        </Grid>
        <Grid x:Name="ContentGrid" Grid.Column="1" Margin="0,40,0,0">
            <Grid.Background>
                <RadialGradientBrush RadiusX="0.9" RadiusY="0.9" Center="0.78,0.4" GradientOrigin="0.78,0.4">
                    <GradientStop Color="#39101F"/>
                    <GradientStop Color="#1A0A14" Offset="0.55"/>
                    <GradientStop Color="#0D070D" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid Margin="18,16,18,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                <Border x:Name="ServersPanel" Grid.Column="0" CornerRadius="14" Background="#150B13" BorderBrush="#412332" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,8,4">
                                <TextBlock Text="{Binding [L008], Source={x:Static local:Localization.Current}}" FontSize="20" FontWeight="SemiBold" Foreground="#FFD27A"/>
                                <Border Background="#30202A" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ServerCountText" Text="0" Foreground="#C9A15C" FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button x:Name="CheckLatencyButton" Grid.Column="1" Width="28" Height="30" Padding="3" Margin="0,0,4,0" Style="{StaticResource ActionButton}" Click="CheckLatency_Click" AutomationProperties.Name="{Binding [L009], Source={x:Static local:Localization.Current}}" ToolTip="{Binding [L009], Source={x:Static local:Localization.Current}}">
                                <Path Data="M 3,16 A 9,9 0 1 1 17,16 M 10,12 L 15,7" Width="18" Height="18" Stretch="Uniform" Stroke="#C9A15C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="RefreshSubscriptionButton" Grid.Column="2" Padding="0" Width="28" Height="30"
                                    AutomationProperties.Name="{Binding [L010], Source={x:Static local:Localization.Current}}" ToolTip="{Binding [L010], Source={x:Static local:Localization.Current}}" IsEnabled="False" Style="{StaticResource ActionButton}" Click="RefreshSubscription_Click">
                                <Path Data="M 15.5,6.5 A 6,6 0 1 0 16,11 M 15.5,2.5 L 15.5,6.5 L 11.5,6.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#C9A15C" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button x:Name="SortServersButton" Grid.Column="3" Width="28" Height="30" Padding="5" Margin="4,0,0,0" Style="{StaticResource ActionButton}" Click="SortServers_Click" AutomationProperties.Name="{Binding [L011], Source={x:Static local:Localization.Current}}" ToolTip="{Binding [L011], Source={x:Static local:Localization.Current}}">
                                <Path Data="M 2,3 L 16,3 M 2,8 L 12,8 M 2,13 L 8,13" Width="16" Height="14" Stretch="Uniform" Stroke="#C9A15C" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Button.ContextMenu><ContextMenu x:Name="SortServersMenu"><MenuItem Header="{Binding [L012], Source={x:Static local:Localization.Current}}" Tag="original" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="{Binding [L013], Source={x:Static local:Localization.Current}}" Tag="name" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="{Binding [L014], Source={x:Static local:Localization.Current}}" Tag="country" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="{Binding [L015], Source={x:Static local:Localization.Current}}" Tag="ping" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="{Binding [L016], Source={x:Static local:Localization.Current}}" Tag="protocol" IsCheckable="True" Click="SortMode_Click"/></ContextMenu></Button.ContextMenu>
                            </Button>
                        </StackPanel></WrapPanel>
                        <TextBox x:Name="ServerSearchText" AutomationProperties.HelpText="{Binding [L017], Source={x:Static local:Localization.Current}}" Grid.Row="1" Margin="0,0,0,12" FontSize="12"
                                 ToolTip="{Binding [L018], Source={x:Static local:Localization.Current}}" AutomationProperties.Name="{Binding [L017], Source={x:Static local:Localization.Current}}" TextChanged="ServerSearch_TextChanged">
                            <TextBox.Background><SolidColorBrush Color="#110A10"/></TextBox.Background>
                        </TextBox>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="ServerSelect" Background="Transparent" BorderThickness="0" Foreground="#E6C07B" PreviewMouseRightButtonDown="ServerRightClick" ContextMenuOpening="ServerMenu_Opening"
                                     FocusVisualStyle="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ContextMenu><ContextMenu x:Name="ServerContextMenu">
                                    <MenuItem IsEnabled="False"><MenuItem.Icon><Image x:Name="ContextServerFlag" Width="18" Height="18"/></MenuItem.Icon><MenuItem.Header><TextBlock x:Name="ContextServerName" MaxWidth="260" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></MenuItem.Header></MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="ContextConnect" Header="{Binding [L019], Source={x:Static local:Localization.Current}}" Click="ContextConnect_Click"><MenuItem.Icon><TextBlock Text="⏻" FontSize="16"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="ContextPing" Header="{Binding [L020], Source={x:Static local:Localization.Current}}" Click="ContextPing_Click"><MenuItem.Icon><TextBlock Text="◴" FontSize="17"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="ContextCopy" Header="{Binding [L021], Source={x:Static local:Localization.Current}}" Click="ContextCopy_Click"><MenuItem.Icon><TextBlock Text="▣"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="ContextEdit" Header="{Binding [L022], Source={x:Static local:Localization.Current}}" Click="ContextEdit_Click"><MenuItem.Icon><TextBlock Text="✎" FontSize="16"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="ContextDelete" Header="{Binding [L023], Source={x:Static local:Localization.Current}}" Foreground="#FF9EAA" Click="ContextDelete_Click"><MenuItem.Icon><TextBlock Text="×" FontSize="18" Foreground="#FF9EAA"/></MenuItem.Icon></MenuItem>
                                </ContextMenu></ListBox.ContextMenu>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border Background="{TemplateBinding Background}">
                                            <ScrollViewer Focusable="False" Padding="0,0,4,0" Style="{StaticResource ThemedScrollViewer}"><ItemsPresenter/></ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,3,5"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ServerBorder" Background="#1C101A" CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ServerBorder" Property="Background" Value="#2A1724"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ServerBorder" Property="Background" Value="#3A2332"/><Setter TargetName="ServerBorder" Property="BorderBrush" Value="#FFD27A"/></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ServerBorder" Property="BorderBrush" Value="#FFD27A"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding CountryFlag}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{local:Translate Path=CountryLabel}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#F1D6A5" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding Protocol}" Foreground="#A78762" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{local:Translate Path=PingDisplay}" Foreground="{Binding PingColor}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="{local:Translate Path=PingDetail}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyServersText" Text="{Binding [L024], Source={x:Static local:Localization.Current}}" Foreground="#A78762" TextWrapping="Wrap" TextAlignment="Center" Margin="18" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,10,0,12">
                            <TextBlock x:Name="ServerSummaryText" Text="{Binding Text, ElementName=SubscriptionStatusText}" Foreground="#A78762" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LatencyStatusText" Text="{Binding [L025], Source={x:Static local:Localization.Current}}" Foreground="#8F7162" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="BestServerButton" Grid.Row="4" Content="{Binding [L026], Source={x:Static local:Localization.Current}}" Click="BestServer_Click" Style="{StaticResource ActionButton}" ToolTip="{Binding [L027], Source={x:Static local:Localization.Current}}"/>
                    </Grid>
                </Border>
                <Grid x:Name="ConnectionPanel" Grid.Column="2" Margin="12,8,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Viewbox Height="52" MaxWidth="280" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                        <Grid Height="48">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Border Height="1" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00C9A15C" Offset="0"/><GradientStop Color="#9B7448" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                            <Path Grid.Column="1" Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Width="6" Height="6" Fill="#B98A4E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BrandTitle" Grid.Column="2" FontFamily="Georgia" FontSize="32" VerticalAlignment="Center" AutomationProperties.Name="VPN4ik">
                                <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF0C7" Offset="0"/><GradientStop Color="#E9BF70" Offset="0.55"/><GradientStop Color="#AD7D3F" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
                                <TextBlock.Effect><DropShadowEffect Color="#FFD27A" BlurRadius="10" ShadowDepth="0" Opacity="0.28"/></TextBlock.Effect>
                                <Run Text="VPN"/><Run Text="4ik" FontStyle="Italic"/>
                            </TextBlock>
                            <Path Grid.Column="3" Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Width="6" Height="6" Fill="#B98A4E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Height="1" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#9B7448" Offset="0"/><GradientStop Color="#00C9A15C" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        </Grid>
                    </Viewbox>
                    <Viewbox x:Name="OrnamentViewbox" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="16,18">
                        <Grid x:Name="OrnamentMotion" Width="380" Height="380" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="OrnamentScale"/></Grid.RenderTransform>
                            <Image x:Name="OrnamentGlow" Source="{StaticResource OrnamentVector}" Stretch="Uniform" Opacity="0" IsHitTestVisible="False" Focusable="False">
                                <Image.Effect><DropShadowEffect Color="#FFD27A" BlurRadius="26" ShadowDepth="0" Opacity="1" RenderingBias="Performance"/></Image.Effect>
                                <Image.CacheMode><BitmapCache RenderAtScale="1.5" SnapsToDevicePixels="False"/></Image.CacheMode>
                            </Image>
                            <local:AlphaHitImage x:Name="OrnamentImage" Source="{StaticResource OrnamentVector}" HitGeometry="{StaticResource OrnamentHitGeometry}"
                               Cursor="Hand" Stretch="Uniform" Focusable="True"
                               AutomationProperties.Name="{Binding [L028], Source={x:Static local:Localization.Current}}" ToolTipService.IsEnabled="False"
                               MouseLeftButtonDown="Ornament_MouseLeftButtonDown" MouseLeftButtonUp="Ornament_MouseLeftButtonUp"
                               LostMouseCapture="Ornament_LostMouseCapture" KeyDown="Ornament_KeyDown"
                               MouseEnter="Ornament_MouseEnter" MouseLeave="Ornament_MouseLeave">
                                <local:AlphaHitImage.CacheMode><BitmapCache RenderAtScale="1.5" SnapsToDevicePixels="False"/></local:AlphaHitImage.CacheMode>
                            </local:AlphaHitImage>
                        </Grid>
                    </Viewbox>
                    <StackPanel Grid.Row="2" Margin="0,0,0,18">
                        <TextBlock x:Name="SelectedServerName" Text="{local:Translate Path=SelectedItem.DisplayName, ElementName=ServerSelect, Fallback=Сервер не выбран, PreserveValue=True}"
                                   Foreground="#F1D6A5" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="#1A0D17" CornerRadius="12" Padding="12,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="#FF6B6B" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="{Binding [L030], Source={x:Static local:Localization.Current}}" Foreground="#E6C07B" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="IpText" Text="" Foreground="#A78762" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="#180D16" BorderBrush="#412332" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [L031], Source={x:Static local:Localization.Current}}" Foreground="#A78762" FontSize="10"/>
                                <TextBlock x:Name="TimeConnectedText" Text="00:00:00" Foreground="#FFD27A" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="ConnectionModeButton" Grid.Column="1" Margin="8,0,0,0" Padding="9,7" Style="{StaticResource ActionButton}" Click="ConnectionMode_Click" AutomationProperties.Name="{Binding [L032], Source={x:Static local:Localization.Current}}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ConnectionModeLabel" Text="Xray TUN" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="#D4AA65" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ConnectionModeMenu">
                                        <MenuItem x:Name="ProxyModeItem" Header="{Binding [L033], Source={x:Static local:Localization.Current}}" IsCheckable="True" Tag="proxy" Click="ConnectionModeItem_Click" ToolTip="{Binding [L034], Source={x:Static local:Localization.Current}}"/>
                                        <Separator/>
                                        <MenuItem Header="TUN" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem x:Name="XrayTunModeItem" Header="Xray TUN" IsCheckable="True" Tag="tun" Click="ConnectionModeItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="LocalDnsMenuItem" Header="{Binding [L035], Source={x:Static local:Localization.Current}}" IsCheckable="True" StaysOpenOnClick="True" Click="LocalDns_Click" ToolTip="{Binding [L036], Source={x:Static local:Localization.Current}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock x:Name="SpeedText" Grid.Row="1" Grid.ColumnSpan="2" Text="0 Mbps" Foreground="#C9A15C" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TrafficText" Grid.Row="2" Grid.ColumnSpan="2" Text="↑ 0 MB | ↓ 0 MB" Foreground="#A78762" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="SectionPanel" Grid.Column="1" Margin="18,56,18,18" Background="#150B13" BorderBrush="#412332" BorderThickness="1" CornerRadius="14" Padding="22" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="SectionBackButton" Content="←" Width="38" Height="36" Padding="0" Click="Home_Click" Style="{StaticResource ActionButton}" ToolTip="{Binding [L037], Source={x:Static local:Localization.Current}}"/>
                    <TextBlock x:Name="SectionTitle" Text="VPN4ik" Foreground="#FFD27A" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ImportPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ThemedScrollViewer}">

                        <StackPanel>
                            <TextBlock Text="{Binding [L038], Source={x:Static local:Localization.Current}}" Foreground="#F1D6A5" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding [L039], Source={x:Static local:Localization.Current}}" Foreground="#A78762" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SubscriptionUrlText" AutomationProperties.HelpText="https://…" MinWidth="0" FontSize="13" AutomationProperties.Name="{Binding [L040], Source={x:Static local:Localization.Current}}"/>
                                <Button x:Name="ImportSubscriptionButton" Grid.Column="1" Content="{Binding [L041], Source={x:Static local:Localization.Current}}" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="ImportSubscription_Click"/>
                            </Grid>
                            <TextBlock x:Name="SubscriptionStatusText" Text="{Binding [L042], Source={x:Static local:Localization.Current}}" Foreground="#C9A15C" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,26"/>
