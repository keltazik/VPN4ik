<Window x:Class="VPNyan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VPNyan"
        Title="VPN4ik" Icon="/VPNyan;component/Assets/VPN4ik.ico" Height="740" Width="1040" MinWidth="760" MinHeight="540"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#110911" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavigationLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="FontSize" Value="13"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggleButton}" Value="True">
                <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9A15C"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="NavItemBorder" Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2,0,0,0"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItemBorder" Property="Background" Value="#281622"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavItemBorder" Property="BorderBrush" Value="#FFD27A"/><Setter Property="Foreground" Value="#FFD27A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C9A15C"/><Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleBorder" Background="Transparent" CornerRadius="8"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#281622"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" Background="#1A0F1A" MouseDown="TopBar_MouseDown" Panel.ZIndex="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="VPN4ik" Foreground="#A78762" VerticalAlignment="Center" FontSize="12" Margin="8,0" IsHitTestVisible="False"/>
            <Button x:Name="MinimizeButton" Grid.Column="2" Content="—" Width="42" Height="40" Click="Minimize_Click" Style="{StaticResource WindowButton}" ToolTip="Свернуть"/>
            <Button x:Name="MaximizeButton" Grid.Column="3" Content="□" Width="42" Height="40" Click="Maximize_Click" Style="{StaticResource WindowButton}" ToolTip="Развернуть"/>
            <Button x:Name="CloseWindowButton" Tag="Close" Grid.Column="4" Content="×" Width="42" Height="40" Click="Close_Click" Style="{StaticResource WindowButton}" ToolTip="Закрыть приложение"/>
        </Grid>
        <Grid x:Name="ContentGrid" Grid.Column="1" Margin="0,40,0,0">
            <Grid.Background>
                <RadialGradientBrush RadiusX="0.9" RadiusY="0.9" Center="0.78,0.4" GradientOrigin="0.78,0.4">
                    <GradientStop Color="#39101F"/>
                    <GradientStop Color="#1A0A14" Offset="0.55"/>
                    <GradientStop Color="#0D070D" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid Margin="18,16,18,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                <Border x:Name="ServersPanel" Grid.Column="0" CornerRadius="14" Background="#150B13" BorderBrush="#412332" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,8,4">
                                <TextBlock Text="Серверы" FontSize="20" FontWeight="SemiBold" Foreground="#FFD27A"/>
                                <Border Background="#30202A" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ServerCountText" Text="0" Foreground="#C9A15C" FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button x:Name="CheckLatencyButton" Grid.Column="1" Width="28" Height="30" Padding="3" Margin="0,0,4,0" Style="{StaticResource ActionButton}" Click="CheckLatency_Click" AutomationProperties.Name="Проверить задержку серверов" ToolTip="Проверить задержку серверов">
                                <Path Data="M 3,16 A 9,9 0 1 1 17,16 M 10,12 L 15,7" Width="18" Height="18" Stretch="Uniform" Stroke="#C9A15C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="RefreshSubscriptionButton" Grid.Column="2" Content="↻" FontSize="20" Padding="3,0" Width="28" Height="30"
                                    ToolTip="Обновить выбранную подписку" IsEnabled="False" Style="{StaticResource ActionButton}" Click="RefreshSubscription_Click"/>
                            <Button x:Name="SortServersButton" Grid.Column="3" Width="28" Height="30" Padding="5" Margin="4,0,0,0" Style="{StaticResource ActionButton}" Click="SortServers_Click" AutomationProperties.Name="Сортировка серверов" ToolTip="Сортировка серверов">
                                <Path Data="M 2,3 L 16,3 M 2,8 L 12,8 M 2,13 L 8,13" Width="16" Height="14" Stretch="Uniform" Stroke="#C9A15C" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Button.ContextMenu><ContextMenu x:Name="SortServersMenu"><MenuItem Header="Порядок подписки" Tag="original" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="По имени · А–Я" Tag="name" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="По стране" Tag="country" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="По пингу · быстрые сначала" Tag="ping" IsCheckable="True" Click="SortMode_Click"/><MenuItem Header="По протоколу" Tag="protocol" IsCheckable="True" Click="SortMode_Click"/></ContextMenu></Button.ContextMenu>
                            </Button>
                        </StackPanel></WrapPanel>
                        <TextBox x:Name="ServerSearchText" AutomationProperties.HelpText="Поиск серверов" Grid.Row="1" Margin="0,0,0,12" FontSize="12"
                                 ToolTip="Поиск по названию или протоколу" AutomationProperties.Name="Поиск серверов" TextChanged="ServerSearch_TextChanged">
                            <TextBox.Background><SolidColorBrush Color="#110A10"/></TextBox.Background>
                        </TextBox>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="ServerSelect" Background="Transparent" BorderThickness="0" Foreground="#E6C07B" PreviewMouseRightButtonDown="ServerRightClick" ContextMenuOpening="ServerMenu_Opening"
                                     FocusVisualStyle="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ContextMenu><ContextMenu x:Name="ServerContextMenu">
                                    <MenuItem IsEnabled="False"><MenuItem.Icon><Image x:Name="ContextServerFlag" Width="18" Height="18"/></MenuItem.Icon><MenuItem.Header><TextBlock x:Name="ContextServerName" MaxWidth="260" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></MenuItem.Header></MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="ContextConnect" Header="Подключиться" Click="ContextConnect_Click"><MenuItem.Icon><TextBlock Text="⏻" FontSize="16"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="ContextPing" Header="Тест пинга" Click="ContextPing_Click"><MenuItem.Icon><TextBlock Text="◴" FontSize="17"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="ContextCopy" Header="Копировать JSON / ссылку" Click="ContextCopy_Click"><MenuItem.Icon><TextBlock Text="▣"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="ContextEdit" Header="Редактировать" Click="ContextEdit_Click"><MenuItem.Icon><TextBlock Text="✎" FontSize="16"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="ContextDelete" Header="Удалить сервер" Foreground="#FF9EAA" Click="ContextDelete_Click"><MenuItem.Icon><TextBlock Text="×" FontSize="18" Foreground="#FF9EAA"/></MenuItem.Icon></MenuItem>
                                </ContextMenu></ListBox.ContextMenu>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border Background="{TemplateBinding Background}">
                                            <ScrollViewer Focusable="False" Padding="0,0,4,0" Style="{StaticResource ThemedScrollViewer}"><ItemsPresenter/></ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,3,5"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ServerBorder" Background="#1C101A" CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ServerBorder" Property="Background" Value="#2A1724"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ServerBorder" Property="Background" Value="#3A2332"/><Setter TargetName="ServerBorder" Property="BorderBrush" Value="#FFD27A"/></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ServerBorder" Property="BorderBrush" Value="#FFD27A"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding CountryFlag}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding CountryLabel}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#F1D6A5" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Protocol}" Foreground="#A78762" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding PingDisplay}" Foreground="{Binding PingColor}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="{Binding PingDetail}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyServersText" Text="Добавь подписку через меню → Импорт" Foreground="#A78762" TextWrapping="Wrap" TextAlignment="Center" Margin="18" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,10,0,12">
                            <TextBlock x:Name="ServerSummaryText" Text="{Binding Text, ElementName=SubscriptionStatusText}" Foreground="#A78762" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LatencyStatusText" Text="TCP-пинг" Foreground="#8F7162" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="BestServerButton" Grid.Row="4" Content="Выбрать лучший сервер" Click="BestServer_Click" Style="{StaticResource ActionButton}" ToolTip="Выбрать сервер с наименьшим свежим TCP-пингом"/>
                    </Grid>
                </Border>
                <Grid x:Name="ConnectionPanel" Grid.Column="2" Margin="12,8,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="VPN4ik" Foreground="#FFD27A" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center">
                        <TextBlock.Effect><DropShadowEffect Color="#FFD27A" BlurRadius="16" ShadowDepth="0" Opacity="0.52"/></TextBlock.Effect>
                    </TextBlock>
                    <Viewbox x:Name="OrnamentViewbox" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="16,18">
                        <Grid x:Name="OrnamentMotion" Width="380" Height="380" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="OrnamentScale"/></Grid.RenderTransform>
                            <local:AlphaHitImage x:Name="OrnamentImage" Source="{StaticResource OrnamentVector}" HitGeometry="{StaticResource OrnamentHitGeometry}"
                               Cursor="Hand" Stretch="Uniform" Focusable="True"
                               AutomationProperties.Name="Подключить или отключить VPN" ToolTipService.IsEnabled="False"
                               MouseLeftButtonDown="Ornament_MouseLeftButtonDown" MouseLeftButtonUp="Ornament_MouseLeftButtonUp"
                               LostMouseCapture="Ornament_LostMouseCapture" KeyDown="Ornament_KeyDown"
                               MouseEnter="Ornament_MouseEnter" MouseLeave="Ornament_MouseLeave">
                                <local:AlphaHitImage.CacheMode><BitmapCache RenderAtScale="1.5" SnapsToDevicePixels="False"/></local:AlphaHitImage.CacheMode>
                            </local:AlphaHitImage>
                        </Grid>
                    </Viewbox>
                    <StackPanel Grid.Row="2" Margin="0,0,0,18">
                        <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=ServerSelect, TargetNullValue=Сервер не выбран, FallbackValue=Сервер не выбран}"
                                   Foreground="#F1D6A5" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="#1A0D17" CornerRadius="12" Padding="12,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="#FF6B6B" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="Отключено" Foreground="#E6C07B" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="IpText" Text="" Foreground="#A78762" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="#180D16" BorderBrush="#412332" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Время подключения" Foreground="#A78762" FontSize="10"/>
                                <TextBlock x:Name="TimeConnectedText" Text="00:00:00" Foreground="#FFD27A" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Трафик VPN" Foreground="#A78762" FontSize="10"/>
                                <TextBlock x:Name="TrafficText" Text="↑ 0 MB | ↓ 0 MB" Foreground="#FFD27A" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SpeedText" Grid.Row="1" Grid.ColumnSpan="2" Text="0 Mbps" Foreground="#C9A15C" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="SectionPanel" Grid.Column="1" Margin="18,56,18,18" Background="#150B13" BorderBrush="#412332" BorderThickness="1" CornerRadius="14" Padding="22" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="SectionBackButton" Content="←" Width="38" Height="36" Padding="0" Click="Home_Click" Style="{StaticResource ActionButton}" ToolTip="Вернуться к серверам"/>
                    <TextBlock x:Name="SectionTitle" Text="VPN4ik" Foreground="#FFD27A" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ImportPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ThemedScrollViewer}">

                        <StackPanel>
                            <TextBlock Text="Подписка" Foreground="#F1D6A5" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Вставь ссылку — серверы появятся в общем списке." Foreground="#A78762" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SubscriptionUrlText" AutomationProperties.HelpText="https://…" MinWidth="0" FontSize="13" AutomationProperties.Name="Ссылка на подписку"/>
                                <Button x:Name="ImportSubscriptionButton" Grid.Column="1" Content="Импортировать" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="ImportSubscription_Click"/>
                            </Grid>
                            <TextBlock x:Name="SubscriptionStatusText" Text="Серверы появятся после импорта" Foreground="#C9A15C" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,26"/>
                            <Border BorderBrush="#412332" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Файл конфигурации" Foreground="#F1D6A5" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Поддерживаются WireGuard .conf и конфигурации Xray .json / .txt." Foreground="#A78762" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button x:Name="ImportConfigButton" Content="Выбрать файл" Click="ImportConfig_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Padding="20,10"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#412332" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="Добавленные подписки и конфигурации" Foreground="#F1D6A5" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="ImportedSourcesList">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#21121D" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                            <StackPanel><TextBlock Text="{Binding Name}" Foreground="#F1D6A5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#A78762" FontSize="12" Margin="0,5,0,9"/>
                                                <WrapPanel><Button Content="Обновить" Click="RefreshSource_Click" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanRefresh}" Margin="0,0,8,0"/><Button Content="Удалить" Click="DeleteSource_Click" Style="{StaticResource ActionButton}" Foreground="#FFA5B0"/></WrapPanel>
                                            </StackPanel>
                                        </Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ImportedSourcesEmpty" Text="Пока ничего не добавлено" Foreground="#8F7162" FontSize="12" Margin="0,2,0,12"/>
                                </StackPanel>
                            </Border>
                            <Button Content="К списку серверов →" Click="Home_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,26,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <RadioButton x:Name="GeneralSettingsTab" GroupName="SettingsTabs" Content="Основные" Tag="general" IsChecked="True" Click="SettingsTab_Click" Style="{StaticResource SettingsTab}"/>
                            <RadioButton x:Name="ConnectionSettingsTab" GroupName="SettingsTabs" Content="Соединение" Tag="connection" Click="SettingsTab_Click" Style="{StaticResource SettingsTab}"/>
                            <RadioButton x:Name="RoutingSettingsTab" GroupName="SettingsTabs" Content="Маршрутизация" Tag="routing" Click="SettingsTab_Click" Style="{StaticResource SettingsTab}"/>
                            <RadioButton x:Name="DisplaySettingsTab" GroupName="SettingsTabs" Content="Интерфейс" Tag="display" Click="SettingsTab_Click" Style="{StaticResource SettingsTab}"/>
                        </WrapPanel>
                        <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ThemedScrollViewer}">
                            <Grid Margin="0,0,12,0" MaxWidth="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel x:Name="GeneralSettings" MaxWidth="700" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Запуск и поведение" Foreground="#F1D6A5" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                                    <CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <CheckBox Content="Запускать свёрнутым" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <CheckBox Content="При сворачивании скрывать в трей" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <CheckBox Content="Подключаться к последнему серверу при запуске" IsChecked="{Binding AutoConnect, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <CheckBox Content="Показывать уведомления о подключении" IsChecked="{Binding ShowNotifications, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                </StackPanel>
                                <StackPanel x:Name="ConnectionSettings" Visibility="Collapsed" MaxWidth="700">
                                    <TextBlock Text="Подключение TUN" Foreground="#F1D6A5" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Параметры соединения применятся после переподключения. Для импортированных WireGuard .conf используются параметры самого файла." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><TextBlock Text="MTU (1280–1500)" Foreground="#E6C07B" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBox x:Name="MtuText" Width="90" AutomationProperties.Name="MTU" TextChanged="MtuText_TextChanged"/></StackPanel>
                                    <CheckBox Content="Локальная сеть напрямую, без VPN" IsChecked="{Binding BypassLocalNetwork, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <TextBlock Text="DNS-серверы" Foreground="#F1D6A5" FontSize="14" Margin="0,12,0,8"/>
                                    <TextBlock Text="От одного до четырёх IP-адресов, каждый с новой строки." Foreground="#A78762" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBox x:Name="DnsServersText" Height="88" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="DNS-серверы" AutomationProperties.HelpText="Например: 1.1.1.1" TextChanged="RoutingText_TextChanged" Tag="dns"/>
                                </StackPanel>
                                <StackPanel x:Name="RoutingSettingsPanel" Visibility="Collapsed" MaxWidth="700">
                                    <TextBlock Text="Раздельное туннелирование" Foreground="#F1D6A5" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Приложения, сайты и подсети можно направить отдельно. Правила применятся после переподключения и работают с профилями Xray; для WireGuard редактируй AllowedIPs в .conf." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>
                                    <CheckBox Content="Включить раздельное туннелирование" IsChecked="{Binding SplitTunnelEnabled, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <WrapPanel Margin="0,6,0,12">
                                        <RadioButton x:Name="BypassModeButton" GroupName="SplitMode" Content="Выбранное без VPN" Tag="Bypass" Click="SplitMode_Click" Style="{StaticResource SettingsTab}"/>
                                        <RadioButton x:Name="IncludeModeButton" GroupName="SplitMode" Content="Только выбранное через VPN" Tag="Include" Click="SplitMode_Click" Style="{StaticResource SettingsTab}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="RoutingModeDescription" Foreground="#C9A15C" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"/>
                                    <TextBlock Text="Приложения" Foreground="#F1D6A5" FontSize="14" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,10"><Button Content="Выбрать .exe" Click="AddSplitApplication_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,6"/><Button x:Name="AddRunningProcessButton" Content="Из запущенных процессов" Click="AddRunningProcess_Click" Style="{StaticResource ActionButton}" Margin="0,0,0,6"/></WrapPanel>
                                    <TextBlock Text="Имя процесса (chrome.exe) или полный путь, с учётом регистра. Каждое правило — с новой строки." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBox x:Name="SplitApplicationsText" Tag="process" Height="92" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Приложения для маршрутизации" AutomationProperties.HelpText="Например: chrome.exe" TextChanged="RoutingText_TextChanged"/>
                                    <TextBlock Text="Домены" Foreground="#F1D6A5" FontSize="14" Margin="0,18,0,8"/>
                                    <TextBlock Text="Например example.org — вместе с поддоменами. По одному на строку. Зашифрованное имя сайта (ECH) может не распознаваться; тогда используй правило приложения или IP." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBox x:Name="SplitDomainsText" Tag="domain" Height="92" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Домены для маршрутизации" AutomationProperties.HelpText="Например: example.org" TextChanged="RoutingText_TextChanged"/>
                                    <TextBlock Text="IP-адреса и подсети" Foreground="#F1D6A5" FontSize="14" Margin="0,18,0,8"/>
                                    <TextBlock Text="По одному правилу на строку: 192.0.2.15 — один IP; 192.0.2.0/24 — подсеть от 192.0.2.0 до 192.0.2.255. Для IPv6: 2001:db8::/32. Это примеры — замени их нужными адресами." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBox x:Name="SplitNetworksText" Tag="ip" Height="92" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="IP и подсети для маршрутизации" AutomationProperties.HelpText="Например: 192.0.2.15 или 192.0.2.0/24" TextChanged="RoutingText_TextChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="DisplaySettings" Visibility="Collapsed" MaxWidth="700">
                                    <TextBlock Text="Скорость и проверка серверов" Foreground="#F1D6A5" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <TextBlock Text="Единицы скорости" Foreground="#E6C07B" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,18">
                                        <RadioButton x:Name="MbpsUnitButton" GroupName="TrafficUnits" Content="Мбит/с (Mbps)" Tag="Mbps" Click="TrafficUnit_Click" Style="{StaticResource SettingsTab}"/>
                                        <RadioButton x:Name="MegabytesUnitButton" GroupName="TrafficUnits" Content="МБ/с (MB/s)" Tag="MB/s" Click="TrafficUnit_Click" Style="{StaticResource SettingsTab}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Показания обновляются каждую секунду. Учитывается трафик выбранного VPN-сервера; прямые исключения в него не входят." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,22"/>
                                    <CheckBox Content="Автоматически проверять TCP-пинг" IsChecked="{Binding AutoCheckPings, Mode=TwoWay}" Click="SettingsCheckBox_Click"/>
                                    <TextBlock Text="Интервал проверки" Foreground="#E6C07B" Margin="0,8,0,10"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="Ping30Button" GroupName="PingInterval" Content="30 секунд" Tag="30" Click="PingInterval_Click" Style="{StaticResource SettingsTab}"/>
                                        <RadioButton x:Name="Ping60Button" GroupName="PingInterval" Content="1 минута" Tag="60" Click="PingInterval_Click" Style="{StaticResource SettingsTab}"/>
                                        <RadioButton x:Name="Ping120Button" GroupName="PingInterval" Content="2 минуты" Tag="120" Click="PingInterval_Click" Style="{StaticResource SettingsTab}"/>
                                    </WrapPanel>
                                    <TextBlock Text="TCP-пинг доступен и при включённом VPN. В этом случае задержка может быть неточной из-за маршрутизации VPN." Foreground="#A78762" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Text="Изменения сохраняются автоматически" Foreground="#8F7162" FontSize="11"/>
                            <TextBlock x:Name="SettingsStatusText" Foreground="#C9A15C" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Button x:Name="ResetAllButton" Content="Сбросить все данные VPN4ik" Click="ResetAll_Click" Style="{StaticResource ActionButton}" Foreground="#FFA5B0" Background="#30131F" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LogsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14"><Button Content="Очистить журнал" Click="ClearLogs_Click" Style="{StaticResource ActionButton}" DockPanel.Dock="Right"/><TextBlock Text="События приложения и VPN-движка" Foreground="#A78762" VerticalAlignment="Center"/></DockPanel>
                        <ListBox x:Name="LogsList" Grid.Row="1">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TimeDisplay}" Foreground="#A78762" FontSize="11"/><TextBlock Text="{Binding Level}" Foreground="{Binding LevelColor}" FontSize="11" Margin="12,0,0,0"/></StackPanel><TextBlock Text="{Binding Message}" Foreground="#E6C07B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid x:Name="HistoryPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14"><Button Content="Очистить историю" Click="ClearHistory_Click" Style="{StaticResource ActionButton}" DockPanel.Dock="Right"/><TextBlock Text="Реальные попытки и сеансы подключения" Foreground="#A78762" VerticalAlignment="Center"/></DockPanel>
                        <ListBox x:Name="HistoryList" Grid.Row="1">
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ServerName}" Foreground="#F1D6A5" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Protocol}" Foreground="#A78762" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding StartedDisplay}" Foreground="#A78762" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="{Binding ExternalIp}" Foreground="#C9A15C" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" FontSize="12" HorizontalAlignment="Right"/><TextBlock Text="{Binding DurationDisplay}" Foreground="#A78762" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="Здесь появится история подключений" Foreground="#A78762" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=HistoryList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="NavigationRail" Grid.Column="0" Margin="0,40,0,0" Background="#150B13" BorderBrush="#412332" BorderThickness="0,0,1,0" Padding="8,8,8,12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ToggleButton x:Name="MenuToggleButton" IsChecked="False" Click="MenuButton_Click" Style="{StaticResource NavigationToggle}" Margin="0,0,0,20" AutomationProperties.Name="Развернуть названия разделов">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Path Data="M 7,4 L 13,10 L 7,16" Stroke="#C9A15C" StrokeThickness="1.7" StrokeLineJoin="Round" Width="20" Height="20" Stretch="None" RenderTransformOrigin="0.5,0.5">
                            <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggleButton}" Value="True"><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="-1"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="Разделы" Foreground="#C9A15C" Style="{StaticResource NavigationLabel}"/>
                    </Grid>
                </ToggleButton>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="ServersNavButton" GroupName="Navigation" IsChecked="True" Click="Home_Click" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Список серверов">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20"><Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5"/><Ellipse Width="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/><Path Data="M 1,10 L 19,10 M 3,5 L 17,5 M 3,15 L 17,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.1"/></Grid>
                            <TextBlock Grid.Column="1" Text="Серверы" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="ImportMenuButton" GroupName="Navigation" Click="ImportMenu_Click" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Добавить конфигурацию">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="ImportIconBox" Width="20" Height="20" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" BorderThickness="1.5" CornerRadius="4"><Grid><Border Width="10" Height="1.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="1.5" Height="10" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                            <TextBlock Grid.Column="1" Text="Добавить" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="SettingsMenuButton" GroupName="Navigation" Click="Settings_Click" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Настройки">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid x:Name="SettingsIcon" Width="22" Height="22"><Path x:Name="SettingsGear" Margin="1" Stretch="Uniform" Data="M 8,0 L 12,0 L 13,3 L 15,4 L 18,3 L 20,6 L 18,9 L 18,11 L 20,14 L 18,17 L 15,16 L 13,17 L 12,20 L 8,20 L 7,17 L 5,16 L 2,17 L 0,14 L 2,11 L 2,9 L 0,6 L 2,3 L 5,4 L 7,3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeLineJoin="Round"/><Ellipse Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/></Grid>
                            <TextBlock Grid.Column="1" Text="Настройки" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="LogsMenuButton" GroupName="Navigation" Click="Logs_Click" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Логи">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20"><Path Data="M 3,1 L 13,1 L 18,6 L 18,19 L 3,19 Z M 13,1 L 13,6 L 18,6 M 6,10 L 15,10 M 6,14 L 15,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Grid>
                            <TextBlock Grid.Column="1" Text="Логи" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="HistoryMenuButton" GroupName="Navigation" Click="History_Click" Style="{StaticResource NavigationItem}" AutomationProperties.Name="История подключений">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20"><Path Data="M 2,9 A 8,8 0 1 1 3,15 M 2,3 L 2,9 L 8,9 M 10,5 L 10,11 L 14,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round"/></Grid>
                            <TextBlock Grid.Column="1" Text="История" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </RadioButton>
                </StackPanel>
                <Border x:Name="SarikSignature" Grid.Row="2" Margin="10,12,10,0" Padding="2,12,0,0" BorderThickness="0,1,0,0" BorderBrush="#412332">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggleButton}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Foreground="#997448" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Sarik" FontFamily="Georgia" FontStyle="Italic" FontSize="21" Foreground="#D9B675"/></StackPanel><TextBlock Text="PERSONAL VPN" Foreground="#806253" FontSize="8" Margin="24,6,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="PingWarning" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="20" Background="#302C2B" BorderBrush="#60472C" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="20,0,20,20" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,14,0"><Path Data="M 11,1 L 21,20 L 1,20 Z" Fill="#FFC400"/><TextBlock Text="!" Foreground="#302C2B" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/></Grid>
                <TextBlock x:Name="PingWarningText" Grid.Column="1" Foreground="#F5ECE3" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
        </Border>
        <Grid x:Name="ActionOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#C0080308" Panel.ZIndex="30" PreviewKeyDown="ActionOverlay_KeyDown">
            <Border MaxWidth="720" MaxHeight="620" Margin="24" Padding="22" CornerRadius="16" Background="#190E17" BorderBrush="#51333F" BorderThickness="1" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DialogTitle" Text="Действие" FontSize="22" FontWeight="SemiBold" Foreground="#F1D6A5" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogDescription" Grid.Row="1" Foreground="#B79B83" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,16"/>
                    <Grid x:Name="EditorPanel" Grid.Row="2" Visibility="Collapsed"><TextBox x:Name="ConfigurationEditor" MinHeight="150" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Конфигурация сервера"/></Grid>
                    <Grid x:Name="ProcessPickerPanel" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBox x:Name="ProcessSearchText" AutomationProperties.HelpText="Поиск по имени или пути" TextChanged="ProcessSearch_TextChanged" Margin="0,0,0,12"/>
                        <ListBox x:Name="ProcessPickerList" Grid.Row="1" MinHeight="160" MaxHeight="360" Background="Transparent">
                            <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0"><CheckBox.Content><StackPanel><TextBlock Text="{Binding Name}" Foreground="#F1D6A5" FontSize="13"/><TextBlock Text="{Binding Detail}" Foreground="#947765" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="540" Margin="0,4,0,0"/></StackPanel></CheckBox.Content></CheckBox></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <TextBlock x:Name="DialogError" Grid.Row="3" Foreground="#FF9EAA" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="DialogCancel" Content="Отмена" Click="DialogCancel_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,6"/><Button x:Name="DialogPrimary" Content="Продолжить" Click="DialogPrimary_Click" Style="{StaticResource ActionButton}" Margin="0,0,0,6"/></WrapPanel>
                </Grid>
            </Border>
        </Grid>    </Grid>
</Window>
