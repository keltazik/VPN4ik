<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="germany.conf" />
    <None Remove="ornament.png" />
    <None Remove="Resources\netherlands.conf" />
    <None Remove="wireguard.exe" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="SettingsWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\wireguard.exe" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ornament.png" />
    <Content Include="Engine\xray.exe;Engine\wintun.dll;Engine\geoip.dat;Engine\geosite.dat;Engine\LICENSE;Engine\LICENSE-Wintun">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
